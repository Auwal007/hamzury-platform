# copy to .env on the server and fill in. never share these values in chat.
# use python tools/configure.py to generate unique bootstrap secrets first.
HAMZURY_ENV=development
# production requires both controls below to be 1; install ClamAV on the host/container.
HAMZURY_REQUIRE_STAFF_MFA=1
HAMZURY_REQUIRE_UPLOAD_SCAN=1
HAMZURY_UPLOAD_SCANNER=clamscan
# owner password is used only to CREATE the first owner. use account security or tools/manage.py to reset it.
HAMZURY_ADMIN_PASSWORD=
HAMZURY_SECRET=
HAMZURY_PUBLIC_BASE_URL=https://hamzury.com
HAMZURY_SECURE_COOKIES=1
HAMZURY_BANK_DETAILS=
HAMZURY_WHATSAPP_NUMBER=
HAMZURY_PAYSTACK_SECRET_KEY=
HAMZURY_BILLING_KEY=
HAMZURY_CONTACT_EMAIL=desk@hamzury.com
# age recipient PUBLIC key for encrypted backups; keep the private identity off the server.
HAMZURY_BACKUP_RECIPIENT=
