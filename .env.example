# local: copy to .env (or run: node tools/configure.js). on vercel: add each value under Settings > Environment Variables.
# never share these values in chat.
HAMZURY_ENV=development

# supabase: Project Settings > Database > Connection string > "Transaction pooler" (port 6543), with your database password.
# leave empty locally to use the embedded database in data/pglite.
DATABASE_URL=
# cloudinary: Dashboard > API environment variable (cloudinary://API_KEY:API_SECRET@CLOUD_NAME).
# leave empty locally to keep files in data/files.
CLOUDINARY_URL=
HAMZURY_CLOUDINARY_FOLDER=hamzury

# production requires both controls below to be 1.
HAMZURY_REQUIRE_STAFF_MFA=1
HAMZURY_REQUIRE_UPLOAD_SCAN=1
# the scanning service each upload is sent to before it is kept. it must answer {"clean": true} or {"clean": false}.
HAMZURY_UPLOAD_SCAN_URL=
HAMZURY_UPLOAD_SCAN_TOKEN=

# owner email is also assigned to an existing owner ONCE if no email has been set yet.
HAMZURY_ADMIN_EMAIL=admin@hamzury.com
# owner password is used only to CREATE the first owner. use account security or tools/manage.js to reset it.
HAMZURY_ADMIN_PASSWORD=
HAMZURY_SECRET=
HAMZURY_PUBLIC_BASE_URL=https://hamzury.com
HAMZURY_SECURE_COOKIES=1
HAMZURY_BANK_DETAILS=
HAMZURY_WHATSAPP_NUMBER=
HAMZURY_PAYSTACK_SECRET_KEY=
HAMZURY_BILLING_KEY=
# vercel sends this to /api/cron/daily every morning. use a long random value.
CRON_SECRET=
HAMZURY_CONTACT_EMAIL=desk@hamzury.com
